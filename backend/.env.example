# FitGenie AI — Environment Configuration Template
# 
# INSTRUCTIONS:
#   1. Copy this file and rename it to ".env"  (no ".example" extension)
#   2. Fill in YOUR actual values in the .env file
#   3. NEVER commit the .env file to version control
#   4. The .env file is listed in .gitignore

# ── Google Gemini API ───────────────────────────────────────────
# Your Gemini API Key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for plan generation
# Recommended: gemini-3.5-flash-lite (fast + affordable)
GEMINI_MODEL=gemini-3.5-flash-lite

# ── LLM Generation Parameters ───────────────────────────────────
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ── Application ─────────────────────────────────────────────────
# Set to "true" for verbose logging during development
DEBUG=false

# URL of the React frontend (used for CORS)
FRONTEND_ORIGIN=http://localhost:3000
